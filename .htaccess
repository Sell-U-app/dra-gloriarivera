# ============================================================
# Dra. Gloria Rivera — Apache config (NameCheap shared hosting)
# ============================================================

Options -Indexes
RewriteEngine On

# ------------------------------------------------------------
# OPCIONAL: forzar HTTPS (descomenta cuando SSL esté activo)
# ------------------------------------------------------------
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ------------------------------------------------------------
# OPCIONAL: forzar www o no-www (elige una opción)
# ------------------------------------------------------------
# Versión sin www (recomendada):
# RewriteCond %{HTTP_HOST} ^www\.dragloriarivera\.com$ [NC]
# RewriteRule ^(.*)$ https://dragloriarivera.com/$1 [L,R=301]

# ------------------------------------------------------------
# URLs limpias: /pagina  →  pagina.php (internamente)
# ------------------------------------------------------------

# 1. Si la URL termina en .php, redirigir 301 a la URL limpia
RewriteCond %{THE_REQUEST} \s/(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. Si /pagina existe como pagina.php, servirla
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# ------------------------------------------------------------
# Cache de assets estáticos (mejora velocidad y SEO)
# ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css   "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# ------------------------------------------------------------
# Compresión gzip (reduce el tamaño de transferencia ~70%)
# ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------
# Cabeceras de seguridad básicas
# ------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ------------------------------------------------------------
# OPCIONAL: páginas de error custom
# ------------------------------------------------------------
# ErrorDocument 404 /index.php
